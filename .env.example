# Keep all values secret. Never commit a real .env file.
APP_PASSWORD=replace-with-a-long-random-passphrase
NODE_ENV=production

# Optional server-side defaults. A project's per-session keys override these.
GITHUB_TOKEN=
GITHUB_TOKEN_EXPIRES_AT=YYYY-MM-DD
ANTHROPIC_API_KEY=
RENDER_API_TOKEN=
RENDER_OWNER_ID=

# Web Push (generate once with web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Set this on the StackPilot Render service to allow it to save/rotate GITHUB_TOKEN in Render env.
STACKPILOT_SERVICE_ID=
