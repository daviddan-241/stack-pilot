# Keep all values secret. Never commit a real .env file.
# Prefer a long password. APP_PIN is optional and, if set, must be exactly four digits.
APP_PASSWORD=replace-with-a-long-random-passphrase
APP_PIN=
NODE_ENV=production

# Optional server-side defaults. Values entered in browser settings can override these.
GITHUB_TOKEN=
GITHUB_TOKEN_EXPIRES_AT=YYYY-MM-DD
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://stack-pilot-builder.onrender.com
RENDER_API_TOKEN=
RENDER_OWNER_ID=

# Web Push (generate once with web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Set this on the StackPilot Render service to save credentials via Settings.
STACKPILOT_SERVICE_ID=
